# --- Core
DATABASE_URL=                 # Neon pooled connection string (Connect → Copy snippet)
APP_URL=                      # https://<your-app>.vercel.app  (no trailing slash)
CRON_SECRET=                  # long random string; also set as a GitHub Actions secret
DASHBOARD_PASSWORD=           # founder/staff sign-in (evaluator view needs none)
PHONE_PEPPER=                 # random string used to hash phone numbers

# --- Vaani (docs.vaanivoice.ai)
VAANI_API_KEY=
VAANI_AGENT_ID=               # filled after the first sync (the sync creates the agent)
VAANI_WEBHOOK_SECRET=         # if Vaani gives you a signing secret (Settings → Webhooks)

# --- Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=   # designers' group chat id (negative number)
TELEGRAM_ALERT_CHAT_ID=       # optional: Nikhil / front-desk-lead chat for SLA + breakage alerts
TELEGRAM_WEBHOOK_SECRET=      # random string; sync sets the webhook with it

# --- HubSpot (service key: contacts + deals read/write, owners read, schemas read)
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=          # "Aangan Enquiries" pipeline id; defaults to the built-in pipeline
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_CLAIMED=
HUBSPOT_STAGE_CONSULTATION_BOOKED=
HUBSPOT_STAGE_CONSULTATION_DONE=
HUBSPOT_STAGE_PROPOSAL=
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=

# --- Cal.com (API v2)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=         # optional; otherwise the first event type (or CALCOM_EVENT_SLUG) is used
CALCOM_EVENT_SLUG=

# --- Resend
RESEND_API_KEY=
RESEND_FROM=                  # "Aangan Studio <hello@your-verified-domain>"; resend.dev only reaches your own inbox
TEAM_EMAIL=                   # records inbox for handoff copies
FOUNDER_EMAIL=                # Nikhil: complaints, SLA, daily digest

# --- Optional second-opinion model (rules work without it)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VERDICT_MODEL=
